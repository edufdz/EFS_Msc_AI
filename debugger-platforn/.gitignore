# Run traces. Anchored to the output directories — a bare `traces/` also
# matches src/traces/, which silently kept five source modules out of the
# repository until a fresh clone failed to import them.
/results/traces/
/results_*/**/traces/
/experiments_output/**/traces/

# Generated JSON output. Scoped to the directories that produce it rather
# than a blanket `*.json`, which previously swallowed the agent maps, the
# frontend package.json and the validation packet.
/fidelity_report.json
/agent_map.json
/test_suite*.json
/persona_library*.json
/coverage_report*.json
/diagnosis_report*.json
/evaluation_report*.json

